{
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "tasks", "questions"],
  "properties": {
    "request_id": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["draft_id", "title", "description", "disciplines", "category", "impact", "classification_reason", "source_block_ids", "scenario_ids", "suggested_primary_reference_id", "subtasks"],
        "properties": {
          "draft_id": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "disciplines": {"type": "array", "items": {"type": "string", "enum": ["art", "dev"]}},
          "category": {"type": "string", "enum": ["core_gameplay", "content", "ui_ux", "polish", "bug_fix", "technical", "production", "unassigned"]},
          "impact": {"type": "string", "enum": ["critical", "high", "medium", "low", "unassessed"]},
          "classification_reason": {"type": "string"},
          "source_block_ids": {"type": "array", "items": {"type": "string"}},
          "scenario_ids": {"type": "array", "items": {"type": "string"}},
          "suggested_primary_reference_id": {"type": ["string", "null"]},
          "subtasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["draft_id", "title", "description", "basis", "source_block_ids", "scenario_ids"],
              "properties": {
                "draft_id": {"type": "string"},
                "title": {"type": "string"},
                "description": {"type": "string"},
                "basis": {"type": "string", "enum": ["source_supported", "inferred"]},
                "source_block_ids": {"type": "array", "items": {"type": "string"}},
                "scenario_ids": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_block_ids"],
        "properties": {
          "text": {"type": "string"},
          "source_block_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
